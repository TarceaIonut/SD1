@inject IHtmlLocalizer<SharedResource> Localizer
@using Microsoft.AspNetCore.Mvc.Localization
@{
    ViewData["Title"] = Localizer["Hospital"];
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/WebApplication2.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">@ViewData["Title"]</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="d-none d-md-block mx-3 text-muted" style="font-size: 0.75rem; line-height: 1.1;">
                <div class="row g-0">
                    <div class="col-4 px-2">@Localizer["Name"]</div>
                    <div class="col-4 px-2 border-start border-end">@Localizer["Email"]</div>
                    <div class="col-4 px-2">@Localizer["Role"]</div>
                </div>
                <div class="row g-0">
                    <div class="col-4 px-2 text-dark">@Context.Session.GetString("UserName")</div>
                    <div class="col-4 px-2 text-dark border-start border-end">@Context.Session.GetString("UserEmail")</div>
                    <div class="col-4 px-2 text-dark">@Localizer[Context.Session.GetString("UserRole") ?? ""]</div>
                </div>
            </div>
            <form asp-controller="Account" asp-action="SignOut" method="post">
                <button type="submit">@Localizer["Sign Out"]</button>
            </form>
            <form asp-controller="Account" asp-action="DeleteMyAccount" method="post">
                <button type="submit">@Localizer["Delete My Account"]</button>
            </form>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="SignIn">@Localizer["Sign In"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="SignUp">@Localizer["Sign Up"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Doctors" asp-action="Doctors">@Localizer["Doctors"] </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Accounts">@Localizer["Accounts"] </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Functions" asp-action="DoctorCheckups">@Localizer["Doctor Checkups"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Functions" asp-action="DoctorCheckupList">@Localizer["Doctor Checkups List"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Chat" asp-action="Chat">@Localizer["Chat"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Language" asp-action="Index">@Localizer["Language"]</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - WebApplication2 - <a asp-area="" asp-controller="Home" asp-action="Privacy">@Localizer["Privacy"]</a>
    </div>
</footer>
<script src="@Url.Content("~/lib/jquery/dist/jquery.min.js")"></script>
<script src="@Url.Content("~/lib/bootstrap/dist/js/bootstrap.bundle.min.js")"></script>
<script src="@Url.Content("~/js/site.js")" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>