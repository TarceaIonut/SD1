@inject IHtmlLocalizer<SharedResource> Localizer
@using Microsoft.AspNetCore.Mvc.Localization
@using Hospital.Models.ViewModels
@model Hospital.Models.ViewModels.AccountsViewModel

@{
    ViewData["Title"] = Localizer["Accounts"];
}

<!DOCTYPE html>

<h1>@ViewData["Title"]</h1>
<div asp-validation-summary="All" class="text-danger"></div>
@if (Model.Show) {
    <table class="accounts table">
        <thead>
        <tr>
            <th>@Localizer["Name"]</th>
            <th>@Localizer["Email"]</th>
            <th>@Localizer["Role"]</th>
        </tr>
        </thead>
        <tbody>
        @if (Model._persons != null)
        {
            @foreach (var p in Model._persons) {
                <tr>
                    <td>@p.Username</td>
                    <th>@p.Email</th>
                    <td>@Localizer[p.role.ToString() ?? ""]</td>
                </tr>
            }
        }
    
        </tbody>
    </table>
    <form method="post">
        <div class="form-group">
            <label asp-for="Format" class="control-label">@Localizer["Format"]</label>
            <select asp-for="Format" 
                    class="form-control" 
                    asp-items="Html.GetEnumSelectList<Hospital.Models.HelperStructures.Formats>()">
                <option value="">-- @Localizer["Select Export Format"] --</option>
            </select>
            <span asp-validation-for="Format" class="text-danger"></span>
            <label asp-for="SortOrder" class="control-label">@Localizer["sortOrder"]</label>
            <select asp-for="SortOrder" 
                    class="form-control" 
                    asp-items="Html.GetEnumSelectList<DoctorCheckupsFunctions.SortOrder>()">
                <option value="">-- @Localizer["Select Sort Order"] --</option>
            </select>
            <span asp-validation-for="SortOrder" class="text-danger"></span>
            <button type="submit" asp-controller="Account" asp-action="ExportAccounts">@Localizer["ExportAccounts"]</button>
        </div>
    </form>
}