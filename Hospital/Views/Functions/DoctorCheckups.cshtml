@inject IHtmlLocalizer<SharedResource> Localizer
@using Microsoft.AspNetCore.Mvc.Localization
@model Hospital.Models.ViewModels.DoctorCheckupVewModel
@{
    ViewData["Title"] = Localizer["Checkups"];
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewData["Title"]</title>
</head>
<body>

<div class="container-fluid">
    <div class="row align-items-start">
        <div class="col-md-4">
            <table class="accounts table table-striped table-bordered">
                <thead>
                <tr>
                    <th>@Localizer["Name"]</th>
                    <th>@Localizer["Email"]</th>
                    <th>@Localizer["Speciality"]</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var doctor in Model.Doctors)
                {
                    <tr>
                        <td>@doctor.Account?.Username</td>
                        <td>@doctor.Email</td>
                        <td>@Localizer[doctor.Specialty?.ToString() ?? ""]</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="col-md-4 d-flex justify-content-center align-items-center mt-5 flex-column">
            <div asp-validation-summary="All" class="text-danger"></div>
            @if (Model.canSelect) { 
                <form asp-controller="Functions" asp-action="DoctorCheckups" method="post">
                    @if (Model.canSelectDoctor) {
                        <div>
                            <div class="input">
                                <label asp-for="DoctorName">@Localizer["Doctor Name"]</label>
                                <input asp-for="DoctorName" placeholder="@($"{Localizer["Enter"].Value} {Localizer["Doctor Name"].Value}")"/>
                            </div>
                            <div class="input">
                                <label asp-for="DoctorEmail">@Localizer["Doctor Email"]</label>
                                <input asp-for="DoctorEmail" placeholder="@($"{Localizer["Enter"].Value} {Localizer["Doctor Email"].Value}")"/>
                            </div>
                        </div>
                    }
                    <div>
                        <div class="input">
                            <label asp-for="PatientName">@Localizer["Patient Name"]</label>
                            <input asp-for="PatientName" placeholder="@($"{Localizer["Enter"].Value} {Localizer["Patient Name"].Value}")"/>
                        </div>
                        <div class="input">
                            <label asp-for="PatientEmail">@Localizer["Patient Email"]</label>
                            <input asp-for="PatientEmail" placeholder="@($"{Localizer["Enter"].Value} {Localizer["Patient Email"].Value}")"/>
                        </div>
                        <div class="input">
                            <label asp-for="AppointmentDate">@Localizer["Appointment Date"]</label>
                            <input asp-for="AppointmentDate" placeholder="@($"{Localizer["Enter"].Value} {Localizer["Appointment Date"].Value}")"/>
                        </div>
                        <div class="input">
                            <label asp-for="Description">@Localizer["Description"]</label>
                            <input asp-for="Description" placeholder="@($"{Localizer["Enter"].Value} {Localizer["Description"].Value}")"/>
                        </div>
                    </div>        
                    <button type="submit">@Localizer["New Checkup"]</button>
                </form>
            }
        </div>
        <div class="col-md-4">
            <table class="accounts table table-striped table-bordered">
                <thead>
                <tr>
                    <th>@Localizer["Name"]</th>
                    <th>@Localizer["Email"]</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var patient in Model.Patients)
                {
                    <tr>
                        <td>@patient.Account?.Username</td>
                        <td>@patient.Email</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

</body>
</html>