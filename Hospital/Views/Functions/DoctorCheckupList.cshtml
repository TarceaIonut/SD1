@inject IHtmlLocalizer<SharedResource> Localizer
@using Microsoft.AspNetCore.Mvc.Localization
@model Hospital.Models.ViewModels.DoctorCheckupsFunctions
@{
    ViewData["Title"] = Localizer["Doctor Checkup List"];
}

<!DOCTYPE html>

<html lang="en">
<body>
<h1>@ViewData["Title"]</h1>
<div asp-validation-summary="All" class="text-danger"></div>
<table class="accounts table">
    <thead>
    <tr>
        <th>@Localizer["Id"]</th>
        <th>@Localizer["Doctor Name"]</th>
        <th>@Localizer["Doctor Email"]</th>
        <th>@Localizer["Speciality"]</th>
        <th>@Localizer["Patient Name"]</th>
        <th>@Localizer["Patient Email"]</th>
        <th>@Localizer["Appointment Date"]</th>
        <th>@Localizer["Description"]</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var c in Model.DoctorCheckups) {
        <tr>
            <th>@c.Id</th>
            <td>@c.Doctor.Account?.Username</td>
            <th>@c.Doctor.Email</th>
            <td>@Localizer[c.Doctor.Specialty?.ToString() ?? ""]</td>
            <th>@c.Patient.Account?.Username</th>
            <th>@c.Patient.Email</th>
            <th>@c.AppointmentDate.ToString("f")</th>
            <th>@c.Description</th>
        </tr>
    }
    </tbody>
</table>
@if (Model.DoctorCheckups.Count > 0) {
    if (Context.Session.GetString("UserRole") != null &&
        Context.Session.GetString("UserRole")!.Equals("Patient") == false) {
        <form method="post">
            <div class="input">
                <label asp-for="Id">@Localizer["Checkup Id"]</label>
                <input asp-for="Id" placeholder="@($"{Localizer["Enter"].Value} {Localizer["Checkup Id"].Value}")"/>
            </div>
            <div class="input">
                <label asp-for="Description">@Localizer["Description"]</label>
                <input asp-for="Description" placeholder="@($"{Localizer["Enter"].Value} {Localizer["Description"].Value}")" type="text"/>
            </div>
            <div class="input">
                <label asp-for="AppointmentDate">@Localizer["Appointment Date"]</label>
                <input asp-for="AppointmentDate" placeholder="@($"{Localizer["Enter"].Value} {Localizer["Appointment Date"].Value}")"/>
            </div>
        
            <button type="submit" asp-controller="Functions" asp-action="DoctorCheckupDelete">@Localizer["Delete"]</button>
            <button type="submit" asp-controller="Functions" asp-action="DoctorCheckupUpdate">@Localizer["Update"]</button>
        </form>
    }
    <form method="post">
        <div class="form-group">
            <label asp-for="sortOn" class="control-label">@Localizer["Sort On"]</label>
            <select asp-for="sortOn" 
                    class="form-control" 
                    asp-items="Html.GetEnumSelectList<Hospital.Models.ViewModels.DoctorCheckupsFunctions.SortOn>().Select(item => new SelectListItem { Value = item.Value, Text = Localizer[item.Text].Value })">
                <option value="">-- @Localizer["Select Field"] --</option>
            </select>
            <span asp-validation-for="sortOn" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="sortOrder" class="control-label">@Localizer["Sort Order"]</label>
            <select asp-for="sortOrder" 
                    class="form-control" 
                    asp-items="Html.GetEnumSelectList<Hospital.Models.ViewModels.DoctorCheckupsFunctions.SortOrder>().Select(item => new SelectListItem { Value = item.Value, Text = Localizer[item.Text].Value })">
                <option value="">-- @Localizer["Select Order"] --</option>
            </select>
            <span asp-validation-for="sortOrder" class="text-danger"></span>
        </div>
        <button type="submit" asp-controller="Functions" asp-action="DoctorCheckupSort">@Localizer["Sort"]</button>
    </form>
    <form method="post">
        <div class="form-group">
            <label asp-for="Format" class="control-label">@Localizer["Format"]</label>
            <select asp-for="Format" 
                    class="form-control" 
                    asp-items="Html.GetEnumSelectList<Hospital.Models.HelperStructures.Formats>().Select(item => new SelectListItem { Value = item.Value, Text = Localizer[item.Text].Value })">
                <option value="">-- @Localizer["Select Format"] --</option>
            </select>
            <span asp-validation-for="Format" class="text-danger"></span>
        </div>
        <button type="submit" asp-controller="Functions" asp-action="Export">@Localizer["Export"]</button>
    </form>
}
</body>
</html>